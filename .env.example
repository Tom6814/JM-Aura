# Copy the variables you need into each service on Zeabur.
# If you deploy via standard Git services, create two services named `web` and `api`
# from the repository root `/`. Zeabur will then auto-match `Dockerfile.web` /
# `Dockerfile.api`, and it can also read `zbpack.web.json` / `zbpack.api.json`.

# web service
# PORT=3000
# Set this when Remix runs as a separate service from the API.
# Leave it empty for local same-origin access or the localhost auto-fallback.
API_ORIGIN=

# api service
# PORT=8787
# Backend source lives under ./api/src/server.
JM_PROXY_URL=
TASK_CONCURRENCY=2
TASK_RUNNER_TIMEOUT_MS=900000
