{
  "name": "jm-aura-remix",
  "version": "3.0.0",
  "description": "",
  "main": "index.js",
  "private": true,
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": "20.x"
  },
  "workspaces": [
    "web",
    "api",
    "packages/*"
  ],
  "scripts": {
    "api": "npm run dev:api",
    "dev": "npm run dev:web",
    "dev:web": "npm --workspace web run dev",
    "dev:api": "npm --workspace api run dev",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm --workspace web run build",
    "build:api": "npm --workspace api run build",
    "start": "npm run start:web",
    "start:web": "npm --workspace web run start",
    "start:api": "npm --workspace api run start",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --import tsx --test workspace-layout.test.ts && npm run test --workspaces --if-present"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@hono/zod-validator": "^0.8.0",
    "@remix-run/node": "^2.17.5",
    "@remix-run/react": "^2.17.5",
    "@remix-run/serve": "^2.17.5",
    "hono": "^4.12.28",
    "isbot": "^4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "undici": "^6.27.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.17.5",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react-router-dom": "^6.30.4",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}
